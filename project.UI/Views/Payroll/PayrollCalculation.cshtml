@model project.Data.Models.Domain.PayrollCalculationModel
@{
    ViewData["Title"] = "PayrollCalculation";
}

@await Html.PartialAsync("_HRNavbar")

<style>
    body {
        background-color: #f6f4ef;
        font-family: 'Poppins', sans-serif;
    }

    h2 {
        color: #333;
        font-weight: 600;
    }

    form {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.1);
    }

    .form-group label {
        font-weight: 500;
        color: #555;
    }

    .form-control {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #ccc;
        transition: all 0.3s ease-in-out;
    }

        .form-control:focus {
            border-color: #f57c00;
            box-shadow: 0px 0px 5px rgba(245, 124, 0, 0.5);
        }

    .btn-primary {
        background: #f57c00;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        transition: 0.3s;
    }

        .btn-primary:hover {
            background: #e66a00;
            box-shadow: 0px 5px 15px rgba(245, 124, 0, 0.4);
        }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border-left: 5px solid #28a745;
        padding: 10px;
        border-radius: 8px;
    }
</style>

<h2>Payroll Calculation</h2>
@if (TempData["AlertMessage"] != null)
{
    <div class="alert alert-success mt-3 message" role="alert">
        @TempData["AlertMessage"]
    </div>
}
<form asp-action="PayrollCalculation" asp-controller="Payroll" method="post">
    <div class="form-group">
        <label for="Username">Select Employee:</label>
        <select asp-for="Username" asp-items="ViewBag.Users" class="form-control" required>
            <option value="">-- Select Employee --</option>
        </select>
    </div>


    <div class="form-group">
        <label>Basic Salary:</label>
        <input type="number" asp-for="BasicSalary" id="basicSalary" class="form-control" oninput="calculatePayroll()" required />
    </div>
    <div class="form-group">
        <label>Allowance:</label>
        <input type="number" asp-for="Allowance" id="allowance" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Bonus:</label>
        <input type="number" asp-for="Bonus" id="bonus" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Commission:</label>
        <input type="number" asp-for="Commission" id="commission" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Overtime Pay:</label>
        <input type="number" asp-for="OvertimePay" id="overtime" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Expense to Office:</label>
        <input type="number" asp-for="ExpenseToOffice" id="expense" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Gross Pay:</label>
        <input type="number" asp-for="GrossPay" id="grossPay" class="form-control" readonly />
    </div>
    <hr>
    <h4>Deductions</h4>
    <div class="form-group">
        <label>Income Tax:</label>
        <input type="number" asp-for="IncomeTax" id="incomeTax" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>PF:</label>
        <input type="number" asp-for="PF" id="pf" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Employee State Insurance:</label>
        <input type="number" asp-for="EmployeeStateInsurance" id="esi" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Professional Tax:</label>
        <input type="number" asp-for="ProfessionalTax" id="professionalTax" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Loan Repayments:</label>
        <input type="number" asp-for="LoanRepayments" id="loanRepayments" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Leave:</label>
        <input type="number" asp-for="LeaveDeductions" id="leave" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Total Deductions:</label>
        <input type="number" asp-for="TotalDeductions" id="deductions" class="form-control" readonly />
    </div>
    <hr>
    <div class="form-group">
        <label>Net Salary:</label>
        <input type="number" asp-for="NetSalary" id="netSalary" class="form-control" readonly />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Save Payroll</button>
</form>

<script>
    function calculatePayroll() {
        let inputs = document.querySelectorAll("input");
        let values = {};
        inputs.forEach(input => values[input.id] = parseFloat(input.value) || 0);

        let grossPay = values.basicSalary + values.allowance + values.bonus + values.commission + values.overtime + values.expense;
        document.getElementById("grossPay").value = grossPay;

        let deductions = values.incomeTax + values.pf + values.esi + values.professionalTax + values.loanRepayments + values.leave;
        document.getElementById("deductions").value = deductions;

        document.getElementById("netSalary").value = grossPay - deductions;
    }
</script>
