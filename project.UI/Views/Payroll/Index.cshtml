@model IEnumerable<project.Data.Models.Domain.PayrollCalculationModel>

@{
    ViewData["Title"] = "Payroll Summary";
}

@await Html.PartialAsync("_AdminNavbar")

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-lg border-0" style="background: #f8f9fa;">
        <h2 class="text-center mb-4" style="color: #333; font-weight: bold;">Payroll Summary</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr class="text-center">
                        <th>@Html.DisplayNameFor(model => model.Username)</th>
                        <th>@Html.DisplayNameFor(model => model.BasicSalary)</th>
                        <th>@Html.DisplayNameFor(model => model.Allowance)</th>
                        <th>@Html.DisplayNameFor(model => model.Bonus)</th>
                        <th>@Html.DisplayNameFor(model => model.Commission)</th>
                        <th>@Html.DisplayNameFor(model => model.OvertimePay)</th>
                        <th>@Html.DisplayNameFor(model => model.GrossPay)</th>
                        <th>@Html.DisplayNameFor(model => model.PF)</th>
                        <th>@Html.DisplayNameFor(model => model.TotalDeductions)</th>
                        <th>@Html.DisplayNameFor(model => model.NetSalary)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td>@Html.DisplayFor(modelItem => item.Username)</td>
                            <td>@Html.DisplayFor(modelItem => item.BasicSalary)</td>
                            <td>@Html.DisplayFor(modelItem => item.Allowance)</td>
                            <td>@Html.DisplayFor(modelItem => item.Bonus)</td>
                            <td>@Html.DisplayFor(modelItem => item.Commission)</td>
                            <td>@Html.DisplayFor(modelItem => item.OvertimePay)</td>
                            <td>@Html.DisplayFor(modelItem => item.GrossPay)</td>
                            <td>@Html.DisplayFor(modelItem => item.PF)</td>
                            <td>@Html.DisplayFor(modelItem => item.TotalDeductions)</td>
                            <td>@Html.DisplayFor(modelItem => item.NetSalary)</td>
                            <td>
                                <button class="btn btn-sm rounded-pill px-3" style="background-color: #8B4513; color: white; border: none;" onmouseover="this.style.backgroundColor='#A0522D'" onmouseout="this.style.backgroundColor='#8B4513'" onclick="downloadPdf(@item.Id)">Generate Slip</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function downloadPdf(id) {
        window.location.href = '/Payroll/DownloadSlip/' + id;
    }
</script>
