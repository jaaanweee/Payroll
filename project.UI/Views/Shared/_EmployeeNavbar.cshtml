<style>
    .navbar {
        border-radius: 10px; /* Makes the navbar rounded */
    }

    .navbar-nav .nav-link {
        color: gray; /* Default color for all navbar links */
        font-weight: normal;
        transition: color 0.3s ease-in-out, font-weight 0.3s ease-in-out;
    }

        .navbar-nav .nav-link.active {
            color: white !important; /* Highlight active navbar link */
            font-weight: bold;
        }

        .navbar-nav .nav-link:hover {
            color: white !important; /* White text on hover */
        }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/Dashboard/DashboardOverview"></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Dashboard Overview" ? "active" : "")" href="/Dashboard/Dash">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Salary" ? "active" : "")" href="/Dashboard/Salary">Salary</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Payroll Management" ? "active" : "")" href="/Leave/Leave">Leave</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Employee Management" ? "active" : "")" href="/Dashboard/Taxes">Taxes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Expense" ? "active" : "")" href="/Expense/Expense">Reimbursements</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Payments" ? "active" : "")" href="/Dashboard/Payments">Payments</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Alerts" ? "active" : "")" href="/Dashboard/Alerts">Alerts</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "Profile" ? "active" : "")" href="/Dashboard/Profile">Profile</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"] == "LeaveById" ? "active" : "")" href="/Leave/GetLeaveById">Leave Status</a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                <li class="nav-item d-flex align-items-center">
                    <span class="nav-link text-white">
                        @TempData["username"]
                        @{
                            TempData.Keep("username");
                        } <!-- Make sure TempData is kept alive after accessing it -->
                    </span>
                    <a class="nav-link text-danger ms-2" href="/Login/Logout" title="Logout">
                        <i class="fa-solid fa-arrow-right-from-bracket" style="color: #cacdd3;"></i> <!-- Font Awesome Icon -->
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
