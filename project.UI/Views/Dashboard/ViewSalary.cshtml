@model IEnumerable<project.Data.Models.Domain.Salary>

@{
    ViewData["Title"] = "ViewSalary";
}
@await Html.PartialAsync("_HRNavbar")

<div class="container mt-5">
    <h2 class="mb-4 text-center main-heading">View Salary</h2>

    <p>
        <a asp-action="Create" class="btn btn-dark btn-lg shadow-sm rounded-pill">+ Add New Salary</a>
    </p>

    <div class="card salary-card">
        <div class="card-body">
            <h5 class="card-title text-center">Salary Details</h5>
            <div class="table-responsive">
                <table class="table text-center salary-table">
                    <thead>
                        <tr>
                            <th>Salary ID</th>
                            <th>Username</th>
                            <th>Basic Salary</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.SalaryId)</td>
                                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                                <td>@Html.DisplayFor(modelItem => item.BasicSalary)</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.SalaryId" class="btn btn-edit">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.SalaryId" class="btn btn-details">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.SalaryId" class="btn btn-delete">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Background & Font Styling */
    body {
        background-color: #f8f9fb;
        font-family: 'Poppins', sans-serif;
        color: #333;
    }

    /* Heading */
    .main-heading {
        font-size: 2rem;
        font-weight: bold;
        color: #222;
    }

    /* Card Styling */
    .salary-card {
        background: #fff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        padding: 20px;
        transition: all 0.3s ease-in-out;
    }

        .salary-card:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
        }

    /* Table Styling */
    .salary-table {
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }

        .salary-table thead {
            background: #222;
            color: #fff;
            font-weight: bold;
        }

        .salary-table tbody tr:hover {
            background-color: #f1f1f1;
        }

        .salary-table th, .salary-table td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #ddd;
        }

    /* Buttons */
    .btn {
        transition: all 0.3s;
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 14px;
    }

    .btn-edit {
        background: #D8CFBC;
        #7E6551  color: #fff;
    }

    .btn-details {
        background: #7E6551;
        color: #fff;
    }

    .btn-delete {
        background: #C4BDAC;
        color: #fff;
    }

        .btn-edit:hover, .btn-details:hover, .btn-delete:hover {
            opacity: 0.85;
        }

    /* Add Button */
    .btn-dark {
        background: #222;
        color: #fff;
        padding: 12px 20px;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: 500;
    }

        .btn-dark:hover {
            background: #444;
        }
</style>
