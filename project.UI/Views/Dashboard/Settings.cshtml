@{
    ViewData["Title"] = ""; // Set the page title
}

@* Include the navbar *@
@await Html.PartialAsync("_AdminNavbar")

<div class="container mt-5">
    <h2 class="mb-4">Payroll Calculation</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-center">Rate & Earning</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Gross Rate</th>
                                    <th>Basic @("70%")</th>
                                    <th>HRA @("30%")</th>
                                    <th>Gross Earning</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>15000</td>
                                    <td>12000</td>
                                    <td>3000</td>
                                    <td>15000</td>
                                </tr>
                                <tr>
                                    <td>40000</td>
                                    <td>32000</td>
                                    <td>8000</td>
                                    <td>40000</td>
                                </tr>
                                <tr>
                                    <td>20000</td>
                                    <td>16000</td>
                                    <td>4000</td>
                                    <td>20000</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-center">Deduction & Net Salary</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>PF</th>
                                    <th>ESIC</th>
                                    <th>P. Tax</th>
                                    <th>Total Deduction</th>
                                    <th>Net Salary</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1440</td>
                                    <td>113</td>
                                    <td>200</td>
                                    <td>1753</td>
                                    <td>13247</td>
                                </tr>
                                <tr>
                                    <td>1800</td>
                                    <td>---</td>
                                    <td>200</td>
                                    <td>2000</td>
                                    <td>38000</td>
                                </tr>
                                <tr>
                                    <td>1800</td>
                                    <td>150</td>
                                    <td>200</td>
                                    <td>2150</td>
                                    <td>17850</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f5f5f5;
    }

    .card {
        background-color: #ffffff;
        border: none;
        border-radius: 12px;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .card:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .table {
        background-color: #fff;
    }

        .table th, .table td {
            vertical-align: middle;
        }

    .table-dark {
        background-color: #333;
        color: #fff;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }
</style>
