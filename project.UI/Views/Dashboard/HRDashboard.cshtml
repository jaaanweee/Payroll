@{
    ViewData["Title"] = "Dashboard Overview";
}

@await Html.PartialAsync("_HRNavbar")

<div class="container-fluid p-5">
    <div class="text-center mb-4">
        <p class="lead">An intuitive dashboard to manage employees efficiently.</p>
    </div>

    <!-- Employee Overview -->
    <div class="p-4 bg-white shadow-lg rounded-3 card-hover">
        <h4 class="text-dark text-uppercase fw-bold mb-4">Employee Overview</h4>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Salary Band (₹)</th>
                </tr>
            </thead>
            <tbody>
                <tr class="hover-row">
                    <td>Ruchika Vete</td>
                    <td>Software Engineer</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td>₹8,00,000 - ₹10,00,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Rajesh Kumar</td>
                    <td>HR Manager</td>
                    <td><span class="badge bg-warning">On Leave</span></td>
                    <td>₹7,00,000 - ₹9,00,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Aisha Patel</td>
                    <td>Data Analyst</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td>₹6,50,000 - ₹8,50,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Santosh Vete</td>
                    <td>Marketing Manager</td>
                    <td><span class="badge bg-danger">Resigned</span></td>
                    <td>₹9,00,000 - ₹11,00,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Vikram Singh</td>
                    <td>DevOps Engineer</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td>₹10,00,000 - ₹12,50,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Sneha Mehta</td>
                    <td>UI/UX Designer</td>
                    <td><span class="badge bg-warning">On Leave</span></td>
                    <td>₹7,50,000 - ₹9,50,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Amit Tiwari</td>
                    <td>Network Administrator</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td>₹6,00,000 - ₹7,50,000</td>
                </tr>
                <tr class="hover-row">
                    <td>Pooja Verma</td>
                    <td>Product Manager</td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td>₹12,00,000 - ₹15,00,000</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    body {
        background-color: #f9fafb;
    }

    .shadow-lg {
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
    }

    .rounded-3 {
        border-radius: 12px;
    }

    .table-container {
        width: 100%;
        background: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }

        .table thead {
            background-color: #222;
            color: white;
            text-transform: uppercase;
        }

        .table th, .table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

    .table-hover tbody tr:hover {
        background-color: #e9ecef;
        cursor: pointer;
    }

    .hover-row:hover {
        background-color: #f1f1f1;
        transform: scale(1.02);
        transition: all 0.3s ease;
    }

    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        width: 100%;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px rgba(0, 0, 0, 0.1);
        }
</style>
