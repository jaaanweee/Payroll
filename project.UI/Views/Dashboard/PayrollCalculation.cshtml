@model project.Data.Models.Domain.PayrollCalculationModel
@{
    ViewData["Title"] = "PayrollCalculation";
}


@await Html.PartialAsync("_HRNavbar")


<h2>Payroll Calculation</h2>

<form>
    <div class="form-group">
        <label>Basic Salary:</label>
        <input type="number" id="basicSalary" class="form-control" oninput="calculatePayroll()" required />
    </div>
    <div class="form-group">
        <label>Allowance:</label>
        <input type="number" id="allowance" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Bonus:</label>
        <input type="number" id="bonus" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Commission:</label>
        <input type="number" id="commission" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Overtime Pay:</label>
        <input type="number" id="overtime" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Expense to Office:</label>
        <input type="number" id="expense" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Gross Pay:</label>
        <input type="number" id="grossPay" class="form-control" readonly />
    </div>
    <hr>
    <h4>Deductions</h4>
    <div class="form-group">
        <label>Income Tax:</label>
        <input type="number" id="incomeTax" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>PF:</label>
        <input type="number" id="pf" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Employee State Insurance:</label>
        <input type="number" id="esi" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Professional Tax:</label>
        <input type="number" id="professionalTax" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Loan Repayments:</label>
        <input type="number" id="loanRepayments" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Leave:</label>
        <input type="number" id="leave" class="form-control" oninput="calculatePayroll()" />
    </div>
    <div class="form-group">
        <label>Total Deductions:</label>
        <input type="number" id="deductions" class="form-control" readonly />
    </div>
    <hr>
    <div class="form-group">
        <label>Net Salary:</label>
        <input type="number" id="netSalary" class="form-control" readonly />
    </div>
</form>

<script>
    function calculatePayroll() {
        let basicSalary = parseFloat(document.getElementById("basicSalary").value) || 0;
        let allowance = parseFloat(document.getElementById("allowance").value) || 0;
        let bonus = parseFloat(document.getElementById("bonus").value) || 0;
        let commission = parseFloat(document.getElementById("commission").value) || 0;
        let overtime = parseFloat(document.getElementById("overtime").value) || 0;
        let expense = parseFloat(document.getElementById("expense").value) || 0;

        let grossPay = basicSalary + allowance + bonus + commission + overtime + expense;
        document.getElementById("grossPay").value = grossPay;

        let incomeTax = parseFloat(document.getElementById("incomeTax").value) || 0;
        let pf = parseFloat(document.getElementById("pf").value) || 0;
        let esi = parseFloat(document.getElementById("esi").value) || 0;
        let professionalTax = parseFloat(document.getElementById("professionalTax").value) || 0;
        let loanRepayments = parseFloat(document.getElementById("loanRepayments").value) || 0;
        let leave = parseFloat(document.getElementById("leave").value) || 0;

        let deductions = incomeTax + pf + esi + professionalTax + loanRepayments + leave;
        document.getElementById("deductions").value = deductions;

        let netSalary = grossPay - deductions;
        document.getElementById("netSalary").value = netSalary;
    }
</script>
