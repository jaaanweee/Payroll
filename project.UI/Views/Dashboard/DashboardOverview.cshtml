@{
    ViewData["Title"] = "Dashboard Overview";
}

@* Include the Navbar *@
@await Html.PartialAsync("_AdminNavbar")

@* Main Dashboard Section *@
<div class="container-fluid vh-100 d-flex flex-column justify-content-center align-items-center overflow-hidden p-2">
    <div class="row w-100 g-2 d-flex flex-nowrap">

        @* Left Panel: Key Metrics *@
        <div class="col-md-5 d-flex align-items-center">
            <div class="p-3 bg-light rounded w-100">
                <h4 class="fw-bold text-center">DASHBOARD OVERVIEW</h4>
                <ul class="list-unstyled mb-0 text-center">
                    <li><strong>Total Employees:</strong> 120</li>
                    <li><strong>Active Employees:</strong> 110</li>
                    <li><strong>Pending Leave Requests:</strong> 5</li>
                    <li><strong>Payroll Processed This Month:</strong> ₹50,000</li>
                </ul>
            </div>
        </div>

        @* Right Panel: Notifications/Alerts *@
        <div class="col-md-5 d-flex align-items-center">
            <div class="bg-light rounded p-3 w-100">
                <h5 class="text-center">Notifications & Alerts</h5>
                <ul class="list-group text-center">
                    <li class="list-group-item">3 Pending Leave Approvals</li>
                    <li class="list-group-item">Payroll Due Tomorrow</li>
                    <li class="list-group-item">New Employee Added</li>
                </ul>
            </div>
        </div>
    </div>

    @* Pie Chart *@
    <div class="row w-100 mt-2 d-flex justify-content-center">
        <div class="col-md-4 d-flex justify-content-center">
            <div class="card shadow-sm" style="width: 100%; max-width: 300px;">
                <div class="card-body p-2">
                    <h6 class="text-center">Employee Distribution</h6>
                    <canvas id="employeeChart" style="width: 100%; height: 200px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* Pie Chart Script *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById("employeeChart").getContext("2d");
        new Chart(ctx, {
            type: "pie",
            data: {
                labels: ["Active Employees", "Inactive Employees"],
                datasets: [{
                    data: [110, 10],
                    backgroundColor: ["#A0A0A0", "#D3D3D3"],
                    borderColor: "#FFFFFF",
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true
            }
        });
    });
</script>
