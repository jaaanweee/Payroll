        <label for="DeductionAmount">Deductions:</label>
        <input type="number" id="DeductionAmount" name="DeductionAmount" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Add Salary</button>
</form>

<hr />

<h2>Salary List</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Salary ID</th>
            <th>Employee ID</th>
            <th>Basic Salary</th>
            <th>Allowance</th>
            <th>Deductions</th>
            <th>Net Salary</th>
            <th>Payroll Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var salary in Model)
        {
            <tr>
                <td>@salary.SalaryID</td>
                <td>@salary.UserID</td>
                <td>@salary.BasicSalary</td>
                <td>@salary.AllowanceAmount</td>
                <td>@salary.DeductionAmount</td>
                <td>@(salary.BasicSalary + salary.AllowanceAmount - salary.DeductionAmount)</td>
                <td>@salary.PayrollDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
 *@