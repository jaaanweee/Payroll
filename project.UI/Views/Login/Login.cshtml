@model project.Data.Models.Domain.UserLoginModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100" style="padding: 20px;">
    <div class="card shadow-lg border-0 p-5 rounded-4 w-100" style="max-width: 600px; background: #F9F8F6; margin: 20px; transition: transform 0.3s ease-in-out;">
        <div class="card-body">
            <h3 class="text-center mb-4" style="color: #212121; font-weight: 700;">Login</h3>

            @if (TempData["msg"] != null)
            {
                <div class="alert alert-info text-center rounded-3" style="font-size: 0.9rem;">@TempData["msg"]</div>
            }

            <form asp-action="Login" method="post" id="loginForm" autocomplete="off">
                <div class="form-group mb-3">
                    <label asp-for="Role" class="form-label" style="color: #666; font-weight: 500;">Select Role</label>
                    <select asp-for="Role" class="form-control shadow-sm rounded-3 border-0 role-dropdown" style="background: #fff; padding: 12px; cursor: pointer; color: #999;">
                        <option selected disabled style="color: #999;">Select your role</option>
                        <option value="Admin" class="dropdown-option" style="background: #fff; color: #212121;">Admin</option>
                        <option value="HRManager" class="dropdown-option" style="background: #fff; color: #212121;">HR Manager</option>
                        <option value="Employee" class="dropdown-option" style="background: #fff; color: #212121;">Employee</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Username" class="form-label" style="color: #666; font-weight: 500;">Username</label>
                    <input asp-for="Username" class="form-control shadow-sm rounded-3 border-0" placeholder="Enter your username" style="background: #fff; padding: 12px; color: #212121;" autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label" style="color: #666; font-weight: 500;">Password</label>
                    <input asp-for="Password" type="password" class="form-control shadow-sm rounded-3 border-0" placeholder="Enter your password" style="background: #fff; padding: 12px; color: #212121;" autocomplete="off" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn w-100 shadow-sm rounded-3" style="background: #212121; color: #fff; font-weight: 600; padding: 12px;">Login</button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="ForgotPassword" asp-controller="Login" style="color: #444; font-size: 0.9rem; font-weight: 500;">Forgot Password?</a>
            </div>


            <div class="text-center mt-4">
                <small style="color: #666;">Don't have an account? <a asp-action="SignUp" style="color: #212121; font-weight: 600;">Sign Up</a></small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('input').forEach(input => input.value = '');
            document.querySelector('select').selectedIndex = 0;
        });

        document.querySelector('.card').addEventListener('mouseover', function () {
            this.style.transform = 'scale(1.03)';
        });
        
        document.querySelector('.card').addEventListener('mouseout', function () {
            this.style.transform = 'scale(1)';
        });
        
        document.querySelector('.role-dropdown').addEventListener('change', function () {
            this.style.color = '#212121';
        });
    </script>

    <style>
        .role-dropdown option {
            background: #fff !important;
            color: #212121 !important;
        }
        .role-dropdown option:hover, .role-dropdown option:focus {
            background: #F5F5F5 !important;
            color: #212121 !important;
        }
    </style>
    
    <partial name="_ValidationScriptsPartial" />
}
