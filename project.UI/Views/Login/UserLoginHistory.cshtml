@model List<UserLoginHistoryViewModel>
@{
    ViewData["Title"] = "UserLoginHistory";
}
@await Html.PartialAsync("_HRNavbar")

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(to right, #f8f8f8, #e6e6e6);
        color: #333;
        margin: 0;
        padding: 0;
    }

    h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #222;
        margin-top: 20px;
        text-align: center;
    }

    .table-container {
        width: 100%;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .table thead {
            background-color: #222;
            color: white;
            text-transform: uppercase;
        }

        .table th, .table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
            word-wrap: break-word;
        }

        .table tbody tr {
            transition: all 0.3s ease;
            background-color: #f8f8f8;
        }

            .table tbody tr:nth-child(even) {
                background-color: #e7dfd7;
            }

            .table tbody tr:hover {
                background-color: #ffefe5;
                transform: scale(1.01);
                cursor: pointer;
            }
</style>

<h2>User Login History</h2>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Login Time</th>
                <th>Logout Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.Username</td>
                    <td>@record.LoginTime</td>
                    <td>@record.LogoutTime</td>
                </tr>
            }
        </tbody>
    </table>
</div>
