@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 rounded-4 border-0 reset-password-card" style="max-width: 500px; width: 100%; text-align: center;">
        <h3 class="mb-4">Reset Password</h3>
        <p class="text-muted">Enter your new password to reset your account access.</p>
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <div class="mb-4">
                <label class="form-label fw-bold">New Password:</label>
                <input type="password" name="newPassword" required class="form-control text-center p-3 rounded-3" placeholder="Enter new password" />
            </div>
            <button type="submit" class="btn btn-dark w-100 p-3 rounded-3">Reset Password</button>
        </form>
    </div>
</div>

<style>
    .reset-password-card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        border-radius: 20px;
    }

    .reset-password-card:hover {
        transform: scale(1.05);
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
    }
</style>
