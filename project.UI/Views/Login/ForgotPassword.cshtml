@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 rounded-4 border-0 forgot-password-card" style="max-width: 500px; width: 100%; text-align: center;">
        <h3 class="mb-4">Forgot Password</h3>
        <p class="text-muted">Enter your email to receive an OTP for password reset.</p>
        <form asp-action="ForgotPassword" method="post">
            <div class="mb-4">
                <label class="form-label fw-bold">Email:</label>
                <input type="email" name="email" required class="form-control text-center p-3 rounded-3" placeholder="Enter your email" />
            </div>
            <button type="submit" class="btn btn-dark w-100 p-3 rounded-3">Send OTP</button>
        </form>
    </div>
</div>

<style>
    .forgot-password-card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        border-radius: 20px;
    }

    .forgot-password-card:hover {
        transform: scale(1.05);
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
    }
</style>
