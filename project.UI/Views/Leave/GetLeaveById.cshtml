@model IEnumerable<LeaveViewModel>
@{
    ViewData["Title"] = "LeaveById";
}
@await Html.PartialAsync("_EmployeeNavbar")

<div class="container mt-5">
    <h2 class="mb-4 text-center">My Leave Requests</h2>

    <div class="card shadow-sm border-0 rounded">
        <div class="card-body">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in Model)
                        {
                            <tr>
                                <td>@leave.LeaveType</td>
                                <td>@leave.StartDate.ToShortDateString()</td>
                                <td>@leave.EndDate.ToShortDateString()</td>
                                <td>
                                    @if (leave.Status == 1)
                                    {
                                        <span class="status status-pending">Pending</span>
                                    }
                                    else if (leave.Status == 2)
                                    {
                                        <span class="status status-approved">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="status status-rejected">Rejected</span>
                                    }
                                </td>
                                <td>@leave.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        font-family: "Inter", sans-serif;
        background-color: #f5f5f5;
        color: #333;
    }

    .card {
        background-color: #ffffff;
        border: none;
        border-radius: 12px;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .card:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    h2 {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        text-transform: uppercase;
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
    }

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0px 12px 35px rgba(0, 0, 0, 0.15);
    }

    th {
        background-color: #000;
        color: #fff;
        font-size: 1.1rem;
        text-align: left;
        padding: 18px;
        text-transform: uppercase;
        font-weight: 700;
    }

    td {
        padding: 15px;
        font-size: 1rem;
        color: #444;
        border-bottom: 1px solid #eee;
    }

    .status {
        font-weight: bold;
        padding: 10px 14px;
        border-radius: 20px;
        display: inline-block;
    }

    .status-pending {
        background: rgba(255, 165, 0, 0.2);
        color: orange;
    }

    .status-approved {
        background: rgba(34, 197, 94, 0.2);
        color: green;
    }

    .status-rejected {
        background: rgba(255, 0, 0, 0.2);
        color: red;
    }
</style>
