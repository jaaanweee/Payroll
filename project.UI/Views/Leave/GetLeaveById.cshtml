@model IEnumerable<LeaveViewModel>
@{
    ViewData["Title"] = "LeaveById";
}

<h2>My Leave Requests</h2>

<table class="table">
    <thead>
        <tr>
            <th>Leave Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Reason</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var leave in Model)
        {
            <tr>
                <td>@leave.LeaveType</td>
                <td>@leave.StartDate.ToShortDateString()</td>
                <td>@leave.EndDate.ToShortDateString()</td>
                <td>
                    @if (leave.Status == 1)
                    {
                        <b style="color: orange;">Pending</b>
                    }
                    else if (leave.Status == 2)
                    {
                        <b style="color: green;">Approved</b>
                    }
                    else
                    {
                        <b style="color: red;">Rejected</b>
                    }
                </td>
                <td>@leave.Reason</td>
            </tr>
        }
    </tbody>
</table>
